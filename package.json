{
  "name": "@local/dsh-autostart",
  "version": "1.0.0",
  "private": true,
  "description": "Windows sign-in autostart for DeepSeek Harness: starts the app silently in the tray through the signed wscript/PowerShell launcher chain.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "payload",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
